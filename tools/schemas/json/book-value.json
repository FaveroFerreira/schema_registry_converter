{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "book-value.json",
  "title": "Book",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "author": {
      "$ref": "author-value.json"
    }
  },
  "required": ["id", "title", "author"]
}
